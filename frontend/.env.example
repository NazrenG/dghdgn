# Application (client) ID of your Entra ID App Registration (same value as backend AzureAd:ClientId)
VITE_AZURE_CLIENT_ID=PASTE-YOUR-APPLICATION-CLIENT-ID-HERE

# "common" = work/school + personal Microsoft accounts. Or your Directory (tenant) ID to restrict to one org.
VITE_AZURE_TENANT_ID=common

# Backend URL (matches backend/Properties/launchSettings.json)
VITE_API_BASE_URL=http://localhost:5080

# Optional. Defaults to api://<VITE_AZURE_CLIENT_ID>/access_as_user
VITE_API_SCOPE=
